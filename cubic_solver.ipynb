import torch
import torch.nn as nn
import torch.optim as optim

# Example cubic equation:
# x³ - 6x² + 11x - 6 = 0
# Roots are 1, 2, 3

a = 1.0
b = -6.0
c = 11.0
d = -6.0

# Random starting value for x
x = torch.tensor([0.5], requires_grad=True)

# ReLU activation
relu = nn.ReLU()

# SGD Optimizer
optimizer = optim.SGD([x], lr=0.01)

# Training loop
for epoch in range(2000):

    optimizer.zero_grad()

    # Cubic equation
    y = a * x**3 + b * x**2 + c * x + d

    # Apply ReLU
    loss = relu(y**2)

    # Backpropagation
    loss.backward()

    # Update x
    optimizer.step()

    if epoch % 200 == 0:
        print(f"Epoch {epoch}: x = {x.item():.6f}, loss = {loss.item():.6f}")

print("\nApproximated root of equation:")
print("x =", x.item())
